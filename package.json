{
  "name": "log-cell",
  "version": "0.1.0",
  "description": "Cyberpunk-inspired Terminal UI Log Reader & Formatter",
  "type": "module",
  "bin": {
    "log": "./src/cli.tsx",
    "log-cell": "./src/cli.tsx",
    "logcell": "./src/cli.tsx"
  },
  "scripts": {
    "dev": "bun run src/cli.tsx",
    "build": "bun build ./src/cli.tsx --outfile=dist/log --compile --minify",
    "start": "NODE_ENV=production bun src/cli.tsx"
  },
  "dependencies": {
    "ink": "^8.0.0",
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "react-devtools-core": "^8.0.0"
  },
  "peerDependencies": {
    "typescript": "^7"
  }
}
